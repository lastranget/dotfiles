#!/usr/bin/env bash
# Harpoon-style pinned file list for the Obsidian vault.
#
#   harpoon add    fzf over every note in the vault; selected notes are pushed
#                  onto the top of the list (re-adding moves a note to the top)
#   harpoon open   fzf over the list; selected notes open in nvim
#                  (1-9 opens the entry with that number directly, 0 opens #10,
#                  ctrl-d removes the highlighted/marked entries)
#   harpoon open N open entry N directly, no picker (the h1..h9, h0 aliases)
#   harpoon ls     print the list, pinned entries first, then newest first
#   harpoon rm F.. remove entries from the list
#
# Entries 1 and 2 are always pinned: 1 is the "eink" note, 2 is this week's
# log -- the one nvim's <leader>ow opens (personal log unless OBSIDIAN_OW=work),
# opened via :ObsOwWeekly so it gets created from its template if missing.
#
# The rest of the list is stored as a JSON array of vault-relative paths in
# harpoon.json next to this script.

set -euo pipefail

VAULT="${HARPOON_VAULT:-$HOME/vaults/Main}"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
STORE="$(dirname "$SELF")/harpoon.json"

[[ -f "$STORE" ]] || echo '[]' > "$STORE"

EINK="work/fleeting/Work Eink Tasks.md"

# This week's log, matching open_weekly() in ~/.config/nvim/lua/plugins/obsidian.lua.
weekly() {
  local dir=weekly
  [[ "${OBSIDIAN_OW:-}" == work ]] && dir=work/weekly
  printf '%s/%s/%s-W%s.md\n' "$dir" "$(date +%G)" "$(date +%G)" "$(date +%V)"
}

# Write stdin to the store atomically.
save() {
  local tmp
  tmp="$(mktemp "$STORE.XXXXXX")"
  cat > "$tmp"
  mv "$tmp" "$STORE"
}

# Print the stored list, dropping entries whose files no longer exist.
stored() {
  local kept=() f
  while IFS= read -r f; do
    [[ -e "$VAULT/$f" ]] && kept+=("$f")
  done < <(jq -r '.[]' "$STORE")
  if (( ${#kept[@]} != $(jq length "$STORE") )); then
    printf '%s\n' "${kept[@]}" | jq -R . | jq -s . | save
  fi
  (( ${#kept[@]} )) && printf '%s\n' "${kept[@]}"
  return 0
}

# The full list: pinned entries first, then the stored ones (minus any pins).
cmd_ls() {
  local week
  week="$(weekly)"
  printf '%s\n' "$EINK" "$week"
  stored | grep -vxF -e "$EINK" -e "$week" || true
}

# Push args onto the top of the list, preserving their given order.
push() {
  printf '%s\n' "$@" | jq -R . | jq -s --slurpfile cur "$STORE" \
    '. as $new | $new + ($cur[0] - $new)' | save
}

cmd_rm() {
  printf '%s\n' "$@" | jq -R . | jq -s --slurpfile cur "$STORE" \
    '. as $del | $cur[0] - $del' | save
}

cmd_add() {
  local picked
  picked="$(cd "$VAULT" && find . \( -name '.*' -a ! -name . \) -prune -o -type f -name '*.md' -print \
    | sed 's|^\./||' | sort \
    | fzf --multi --prompt='harpoon add> ' \
          --header='tab: mark multiple, enter: add' \
          --preview="head -50 -- {}")" || return 0
  [[ -n "$picked" ]] || return 0
  # Newest selection on top: reverse fzf's selection order.
  mapfile -t files < <(tac <<< "$picked")
  push "${files[@]}"
  printf 'harpooned: %s\n' "${files[@]}"
}

# The list with the first 10 entries prefixed "N<tab>" (1-9, then 0 for the
# 10th), the rest "<space><tab>".
cmd_numbered() {
  cmd_ls | awk '{ printf "%s\t%s\n", (NR < 10 ? NR : NR == 10 ? 0 : " "), $0 }'
}

# Print entry N of the list (1-based; 0 means the 10th).
entry() {
  local n=$(( $1 == 0 ? 10 : $1 ))
  cmd_ls | sed -n "${n}p"
}

# Open the given vault-relative notes in nvim. This week's log goes through
# :ObsOwWeekly so it is created from its template when it doesn't exist yet.
open_files() {
  local week f args=() files=()
  week="$(weekly)"
  for f in "$@"; do
    if [[ "$f" == "$week" ]]; then args=(-c ObsOwWeekly); else files+=("$f"); fi
  done
  cd "$VAULT"
  exec nvim "${args[@]}" -- "${files[@]}"
}

cmd_open() {
  local out key
  if [[ -n "${1:-}" ]]; then
    [[ "$1" =~ ^[0-9]+$ ]] || { echo "harpoon: not an entry number: $1" >&2; return 1; }
    mapfile -t files < <(entry "$1")
    (( ${#files[@]} )) || { echo "harpoon: no entry $1" >&2; return 1; }
    open_files "${files[@]}"
  fi
  out="$(cd "$VAULT" && cmd_numbered \
    | fzf --multi --no-sort --layout=reverse --prompt='harpoon> ' \
          --delimiter=$'\t' --nth=2.. --expect=1,2,3,4,5,6,7,8,9,0 \
          --header='1-9,0: open #, enter: open, tab: mark multiple, ctrl-d: remove' \
          --bind="ctrl-d:execute-silent('$SELF' rm {+2})+reload('$SELF' numbered)" \
          --preview="head -50 -- {2} 2>/dev/null || echo '(not created yet)'")" || return 0
  key="$(head -1 <<< "$out")"
  if [[ -n "$key" ]]; then
    mapfile -t files < <(entry "$key")
  else
    mapfile -t files < <(tail -n +2 <<< "$out" | cut -f2-)
  fi
  (( ${#files[@]} )) && [[ -n "${files[0]}" ]] || return 0
  open_files "${files[@]}"
}

case "${1:-open}" in
  add)  cmd_add ;;
  open) cmd_open "${2:-}" ;;
  ls)   cmd_ls ;;
  numbered) cmd_numbered ;;
  rm)   shift; cmd_rm "$@" ;;
  *)    sed -n '2,19p' "$SELF" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
